# Resend API key — free tier: 3,000 emails/month, 100/day.
# Sign up at https://resend.com with anasmallick846@gmail.com, then
# API Keys -> Create. No domain verification needed: an unverified sender
# may still deliver to the account owner's own address, which is the only
# recipient this form has.
#
# Server-only on purpose (no NEXT_PUBLIC_ prefix): this is a real secret and
# never reaches the browser. app/api/contact/route.ts reads it.
RESEND_API_KEY=re_your_key_here
